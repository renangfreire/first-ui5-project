<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog id="meuDialogo" title="Confirmação">
    <VBox class="sapUiSmallMargin" alignItems="Center">
      <Text text="Você deseja continuar?"/>
    </VBox>

    <beginButton>
      <Button icon="sap-icon://accept" text="Sim" press=".onConfirmar" type="Emphasized" />
    </beginButton>

    <endButton>
      <Button text="Cancelar" press=".onFecharDialogo('DialogExemplo')" />
    </endButton>
  </Dialog>

</core:FragmentDefinition>
