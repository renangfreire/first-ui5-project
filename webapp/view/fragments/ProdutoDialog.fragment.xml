<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  >
    <Dialog id="produtoDialog" title="{= ${managedProduct>/mode} === 'EDIT' ? 'Edição de Produto' : 'Criação de Produto' }">
        <VBox class="sapUiSmallMargin">
            <Input value="{managedProduct>/data/ProductName}" placeholder="Nome do produto" />
            <Input class="sapUiSmallMarginTop" value="{managedProduct>/data/UnitsInStock}" type="Number" placeholder="Quantidade" />
            <Input class="sapUiSmallMarginTop" value="{managedProduct>/data/QuantityPerUnit}" placeholder="Unidades por Quantidade" />
            <Input class="sapUiSmallMarginTop" value="{managedProduct>/data/UnitPrice}" type="Number" placeholder="Preço" />
            <CheckBox class="sapUiSmallMarginTop" text="Produto Descontinuado?" selected="{managedProduct>/data/Discontinued}"></CheckBox>
        </VBox>
        <buttons>
            <Button type="Reject" icon="sap-icon://delete" text="Deletar Produto" visible="{= ${managedProduct>/mode} === 'EDIT'}" press="onExcluirProduto"></Button>
            <Button type="Emphasized" text="Salvar" press="onSalvarProduto" />
            <Button text="Cancelar" press="onFecharDialogo('ProdutoDialog')" />
        </buttons>
        <beginButton>
        </beginButton>
        <endButton>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
