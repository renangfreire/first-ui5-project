<mvc:View
  controllerName="studies.firstui5project.controller.Detalhes"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m">
  <Page
    title="{produtoModel>/nome}"
    showNavButton="true"
    navButtonPress="onNavBack">
    <content>
      <ObjectHeader
        title="{produtoModel>/ProductName}"
        number="{ path: 'produtoModel>/UnitPrice', formatter: '.formatter.formatarPreco' }"
        numberUnit="BRL" />

      <VBox class="sapUiMediumMargin">
        <ObjectStatus
          text="{ path: 'produtoModel>/Discontinued', formatter: '.formatter.traduzirStatus' }"
          state="{ path: 'produtoModel>/Discontinued', formatter: '.formatter.corStatus' }" />

        <VBox class="sapUiSmallMarginTop">
            <Label 
                text="Quantidade" />
            <Text
            text="{produtoModel>/UnitsInStock}" />
        </VBox>
      </VBox>
    </content>
  </Page>
</mvc:View>